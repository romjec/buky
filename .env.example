# Öffentliche URL der Seite (für Bestätigungslinks in E-Mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase – Projekt-URL und Service-Role-Key (nur serverseitig verwendet!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend – für die Double-Opt-in-Mail
RESEND_API_KEY=
RESEND_FROM="Buky <hallo@buky.ch>"

# PostHog (EU-Cloud, Free Tier) – leer lassen = kein Tracking
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
